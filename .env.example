# Core
NODE_ENV=development
DATABASE_URL=postgresql://securescope:change-me@localhost:5432/securescope
API_PORT=4000
# Public origin of the web app (used for Origin checks and links)
APP_ORIGIN=http://localhost:3000
# Set to true behind a TLS-terminating proxy in production
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# Scanning
# Comma-separated TCP ports probed by the exposed-services module
SCAN_PORTS=21,22,23,25,53,80,110,143,443,445,465,587,993,995,1433,1521,2375,3306,3389,5432,5900,6379,8080,8443,9200,11211,27017
SCAN_TIMEOUT_MS=5000
MONITOR_TICK_SECONDS=300

# Breach monitoring (optional)
# Have I Been Pwned domain search. Domains must also be verified inside your HIBP dashboard.
HIBP_API_KEY=
HIBP_USER_AGENT=SecureScope

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SecureScope <alerts@example.com>"
